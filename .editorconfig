# Editor / formatter defaults for this repository.
# Match the AGENTS.md style notes: two-space indent, LF line endings,
# trim trailing whitespace. Final newline is mandatory.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.yml]
indent_size = 2